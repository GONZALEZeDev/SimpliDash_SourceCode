{
  "name": "simplidash",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist":  "electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^36.7.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "axios": "^1.10.0",
    "jspdf": "^3.0.1",
    "jspdf-autotable": "^5.0.2"
  },

  "build": {
    "appId": "com.tondomaine.simplidash",
    "productName": "SimpliDash",
    "files": [
      "main.js",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets/icon"
    },
    "win": {
      "icon": "Logo_SimpliDash-removebg-preview.ico",
      "target": ["nsis","zip"]
    },
    "mac": {
      "icon": "Logo_SimpliDash-removebg-preview.icns",
      "target": ["dmg","zip"]
    },
    "linux": {
      "icon": "Logo_SimpliDash-removebg-preview.png",
      "target": ["AppImage","deb"]
    }
  }
}
